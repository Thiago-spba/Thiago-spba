rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /chronos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /turmas/{doc}     { allow read, write: if true; }
    match /alunos/{doc}     { allow read, write: if true; }
    match /notas/{doc}      { allow read, write: if true; }
    match /relatorios/{doc} { allow read, write: if true; }
    match /config/{doc} { allow read, write: if true; }
  }
}