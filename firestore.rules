rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'thiago.rpba@gmail.com';
    }

    match /usuarios/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Chronos Academy — conteúdo público pros alunos lerem, só você edita
    match /chronos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diário do Professor — privado, só você lê e escreve (notas de aluno)
    match /turmas/{doc}     { allow read, write: if isAdmin(); }
    match /alunos/{doc}     { allow read, write: if isAdmin(); }
    match /notas/{doc}      { allow read, write: if isAdmin(); }
    match /relatorios/{doc} { allow read, write: if isAdmin(); }
    match /config/{doc}     { allow read, write: if isAdmin(); }

    // Não usada em nenhum dos apps revisados até agora — privada por padrão
    match /quizzes/{doc}    { allow read, write: if isAdmin(); }

    // quiz-futuro — alunos precisam ler a tarefa pra responder, só você edita
    match /tarefas/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /resumos/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /turmas_config/{doc} { allow read: if true; allow write: if isAdmin(); }
  }
}
